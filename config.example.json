{
  "threshold": 0.90,
  "database": "prisvakt.db",
  "notify": {
    "ntfy_topic": "",
    "webhook_url": ""
  },
  "sites": [
    {
      "name": "Komplett",
      "browser": true,
      "start_urls": ["https://www.komplett.no/sitemap.xml"],
      "link_pattern": "/product/",
      "max_pages": 300,
      "concurrency": 3,
      "delay": 0.3
    },
    {
      "name": "Power",
      "start_urls": ["https://www.power.no/services/sitemap.xml"],
      "link_pattern": "/p-\\d+",
      "max_pages": 300,
      "concurrency": 8,
      "delay": 0.1
    },
    {
      "name": "Elkjøp",
      "start_urls": ["https://www.elkjop.no/sitemaps/OCNOELK.pdp.index.sitemap.xml"],
      "exclude_pattern": "/product/(hvitevarer|hjem-rengjoring-og-kjokkenutstyr|epoq-kjokken-og-vaskerom|personlig-pleie-skjonnhet-og-velvare|mobil-nettbrett-og-smartklokker/(mobiltilbehor|klokkereimer-og-tilbehor))/",
      "link_pattern": "/product/",
      "max_pages": 300,
      "concurrency": 8,
      "delay": 0.1
    }
  ]
}
